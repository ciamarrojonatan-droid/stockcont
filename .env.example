# ==========================================
# 4. Google Drive Cloud & Local Asset Backup
# ==========================================
# Modo A (Recomendado): Google Drive API via Service Account
# Crie uma Service Account no Google Cloud Console, baixe a chave JSON e aponte o arquivo ou cole o JSON:
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""

# ID da pasta de destino no Google Drive (opcional - se vazio, cria/usa a pasta "StockCont_Backup"):
GOOGLE_DRIVE_FOLDER_ID=""

# Modo B: OAuth 2.0 (se usar credenciais de aplicativo pessoal)
GOOGLE_DRIVE_CREDENTIALS_FILE=""
GOOGLE_DRIVE_TOKEN_FILE="token.json"

# Modo C: Sincronização Local (se usar o Google Drive para Desktop instalado no Windows)
# Exemplo: "G:\Meu Drive\StockCont_Backup"
GOOGLE_DRIVE_LOCAL_PATH=""

